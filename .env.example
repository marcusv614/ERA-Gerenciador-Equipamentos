APP_PORT=8088
POSTGRES_DB=era_erp
POSTGRES_USER=era
POSTGRES_PASSWORD=troque-esta-senha-do-banco
ADMIN_INITIAL_NAME=Administrador ERA
ADMIN_INITIAL_LOGIN=admin
ADMIN_INITIAL_PASSWORD=troque-esta-senha-inicial
SESSION_TIMEOUT=30m
APP_TIMEZONE=America/Manaus

# Recuperação exclusiva de ADMIN: habilitar somente após configurar o Gmail.
RECOVERY_ENABLED=false
RECOVERY_PUBLIC_URL=http://localhost:8088
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Senha de app do Google (não a senha pessoal). Nunca versionar o .env real.
MAIL_PASSWORD=
